    print("  so section J gives Tr = h_N(1,1,c^2) = sum_a c^{2a}(N+1-a)")
    print("  = (N+1)/sin^2 t - cos^2 t/sin^4 t + O(cos^{2N} t) EXACTLY.")
    print(f"{'t':>7} {'1/sin^2 t':>11} {'N':>4} {'Tr(SVD)':>14} "
          f"{'Tr(exact)':>14} {'Tr/N':>10}")
    for t in (0.9, 0.4):
        c, sn = math.cos(t), math.sin(t)
