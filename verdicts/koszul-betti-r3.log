             ncols = bf.dim_h(nv, M)
             R, piv = rref_mod_p(bf.macaulay_rows(gens, M), ncols, p)
             pivset = set(piv)
             nonpiv = [c for c in range(ncols) if c not in pivset]
             pos = {c: t for t, c in enumerate(nonpiv)}
             red = {c: {pos[c]: 1} for c in nonpiv}
             for ri, c in enumerate(piv):
