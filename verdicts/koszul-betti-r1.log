   123	def rank_mod_p(rows, p=P_MOD):
   124	    """Exact rank over GF(p) of an integer matrix (lower bound on rank over Q;
   125	    equal for a random large p).  Gaussian elimination in int64."""
   126	    if not rows:
   127	        return 0
   128	    M = np.array([[int(x) % p for x in r] for r in rows], dtype=np.int64)
   129	    nr, nc = M.shape
   130	    r = 0
   131	    for c in range(nc):
   132	        piv = None
   133	        for i in range(r, nr):
   134	            if M[i, c]:
   135	                piv = i
   136	                break
   137	        if piv is None:
   138	            continue
   139	        M[[r, piv]] = M[[piv, r]]
   140	        inv = pow(int(M[r, c]), p - 2, p)
   141	        M[r] = (M[r] * inv) % p
   142	        col = M[r + 1:, c].copy()
   143	        nz = np.nonzero(col)[0]
   144	        if len(nz):
   145	            M[r + 1 + nz] = (M[r + 1 + nz] - col[nz][:, None] * M[r][None, :]) % p
   146	        r += 1
   147	        if r == nr:
   148	            break
   149	    return r
