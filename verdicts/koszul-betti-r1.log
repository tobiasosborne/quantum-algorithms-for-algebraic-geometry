    58	# ---------- a(f): h_N -> h_{N-m}, orthonormal bases ----------
    59	def annihilation_matrix(f, N, dtype=complex):
    60	    """Matrix A of a(f) = sum_a conj(f_a) d^a  from h_N to h_{N-m} in |k> bases."""
    61	    nv = poly_nvars(f)
    62	    m = poly_deg(f)
    63	    rows = monomials(nv, N - m)
    64	    cols = monomials(nv, N)
    65	    ridx = mono_index(nv, N - m)
    66	    A = np.zeros((len(rows), len(cols)), dtype=dtype)
    67	    for cj, k in enumerate(cols):
    68	        for a, ca in f.items():
    69	            ok = True
    70	            ff = 1
    71	            for j in range(nv):
    72	                if a[j] > k[j]:
    73	                    ok = False
    74	                    break
    75	                # falling factorial k_j (k_j-1) ... (k_j-a_j+1)
    76	                for t in range(a[j]):
    77	                    ff *= (k[j] - t)
    78	            if not ok:
    79	                continue
    80	            kk = tuple(k[j] - a[j] for j in range(nv))
    81	            A[ridx[kk], cj] += np.conj(ca) * math.sqrt(ff)
    82	    return A
