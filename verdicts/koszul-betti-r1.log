import itertools, math
import sympy as s

def mons(v,N):
    if N<0:return []
    return [a for a in itertools.product(range(N+1), repeat=v) if sum(a)==N]
def mac(gens,v,N):
    ms=mons(v,N); pos={a:i for i,a in enumerate(ms)}; rows=[]
    for g in gens:
      d=sum(next(iter(g)))
      for b in mons(v,N-d):
       r=[0]*len(ms)
       for a,c in g.items():r[pos[tuple(a[k]+b[k] for k in range(v))]]+=c
       rows.append(r)
    return s.Matrix(rows) if rows else s.zeros(0,len(ms))
def wb(gens,v,N):
    ms=mons(v,N); D=s.diag(*[math.prod(math.factorial(x) for x in a) for a in ms])
    V=(mac(gens,v,N)*D).nullspace(); B=s.Matrix.hstack(*V) if V else s.zeros(len(ms),0)
    return B, B.T*D*B
def der(v,N,k):
    aa,bb=mons(v,N),mons(v,N-1); pos={x:i for i,x in enumerate(bb)}; A=s.zeros(len(bb),len(aa))
    for col,x in enumerate(aa):
      if x[k]:
       y=list(x); y[k]-=1; A[pos[tuple(y)],col]=x[k]
    return A
def subs(v,i):return list(itertools.combinations(range(v),i))
def qmat(v,i,N,W):
    Bs,Gs=W[N]; Bt,Gt=W[N-1]; SS,TT=subs(v,i),subs(v,i+1); tp={x:r for r,x in enumerate(TT)}
    Q=s.zeros(Bt.cols*len(TT),Bs.cols*len(SS))
    if N<=0 or i>=v:return Q
    for k in range(v):
      Y=der(v,N,k)*Bs; C=Gt.inv()*Bt.T*s.diag(*[math.prod(math.factorial(x) for x in a) for a in mons(v,N-1)])*Y
      for cs,S in enumerate(SS):
       if k in S:continue
       sg=(-1)**sum(x<k for x in S); rt=tp[tuple(sorted(S+(k,)))]
       for a in range(C.rows):
        for b in range(C.cols):Q[rt*Bt.cols+a,cs*Bs.cols+b]+=sg*C[a,b]
    return Q
def blockG(W,v,i,N): return s.kronecker_product(W[N][1],s.eye(math.comb(v,i)))
def lap(gens,v,i,N,maxN):
 W={d:wb(gens,v,d) for d in range(maxN+2)}; G=blockG(W,v,i,N); L=s.zeros(G.rows)
 qo=qmat(v,i,N,W)
 if qo.rows and qo.cols:
  Go=blockG(W,v,i+1,N-1); L+=G.inv()*qo.T*Go*qo
 if i:
  qi=qmat(v,i-1,N+1,W)
  if qi.rows and qi.cols:
   Gi=blockG(W,v,i-1,N+1); L+=qi*Gi.inv()*qi.T*G
 return s.factor(L.charpoly().as_expr()),L.eigenvals()
