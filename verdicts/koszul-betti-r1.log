   206	def ak_matrices(nv, N):
   207	    """[a_k : R_N -> R_{N-1}] in the |k> ONB, one matrix per variable."""
   208	    if N <= 0:
   209	        return [np.zeros((0, bf.dim_h(nv, N)), dtype=complex) for _ in range(nv)]
   210	    return [bf.annihilation_matrix({bf.emono(nv, [k]): 1}, N) for k in range(nv)]
