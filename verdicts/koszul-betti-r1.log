    83	def rref_mod_p(rows, ncols, p=P_MOD):
    84	    """Reduced row echelon form over GF(p).  Returns (R, pivots)."""
    85	    if not rows:
    86	        return np.zeros((0, ncols), dtype=np.int64), []
    87	    M = np.array([[int(x) % p for x in r] for r in rows], dtype=np.int64)
    88	    nr = M.shape[0]
    89	    r = 0
    90	    pivots = []
    91	    for c in range(ncols):
    92	        piv = None
    93	        for i in range(r, nr):
    94	            if M[i, c]:
    95	                piv = i
    96	                break
    97	        if piv is None:
    98	            continue
    99	        M[[r, piv]] = M[[piv, r]]
   100	        inv = pow(int(M[r, c]), p - 2, p)
   101	        M[r] = (M[r] * inv) % p
   102	        col = M[:, c].copy()
   103	        col[r] = 0
   104	        nz = np.nonzero(col)[0]
   105	        if len(nz):
   106	            M[nz] = (M[nz] - col[nz][:, None] * M[r][None, :]) % p
   107	        pivots.append(c)
   108	        r += 1
   109	        if r == nr:
   110	            break
   111	    return M[:r], pivots
