   424	def cycle_complex(m):
   425	    """Simplicial complex of the m-cycle: vertices 0..m-1, edges (i,i+1 mod m).
   426	    Returns (faces, Stanley-Reisner generators) in m variables."""
   427	    faces = [()] + [(v,) for v in range(m)]
   428	    edges = set()
   429	    for v in range(m):
   430	        edges.add(tuple(sorted((v, (v + 1) % m))))
   431	    faces += sorted(edges)
   432	    gens = []
   433	    for a in range(m):
   434	        for b in range(a + 1, m):
   435	            if (a, b) not in edges:
   436	                gens.append(bf.emono(m, [a, b]))
   437	    return faces, [{g: 1} for g in gens]
