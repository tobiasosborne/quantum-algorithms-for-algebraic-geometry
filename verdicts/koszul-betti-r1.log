   471	def hochster_betti(faces, m, i, j):
   472	    """Hochster's formula: beta_{i,j}(R/I_Delta) =
   473	    sum_{|sigma| = j} dim H~_{j-i-1}(Delta|_sigma)."""
   474	    tot = 0
   475	    for sigma in subsets(m, j):
   476	        k = j - i - 1
   477	        h = reduced_homology(faces, sigma)
   478	        tot += h.get(k, 0)
   479	    return tot
