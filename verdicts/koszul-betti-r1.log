   194	def kernel_basis(gens, nv, N, kerdim):
   195	    """(dim R_N) x kerdim matrix of an orthonormal basis of ker H_N (|k> ONB)."""
   196	    MN = bf.dim_h(nv, N)
   197	    if kerdim == 0:
   198	        return np.zeros((MN, 0), dtype=complex)
   199	    A = bf.stacked_A(gens, N)
   200	    if A.shape[0] == 0:
   201	        return np.eye(MN, dtype=complex)
   202	    _, s, Vh = np.linalg.svd(A)
   203	    return Vh[MN - kerdim:].conj().T
