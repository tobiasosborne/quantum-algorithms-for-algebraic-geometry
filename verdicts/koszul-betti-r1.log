   440	def reduced_homology(faces, sigma, p=P_MOD):
   441	    """dim H~_k(Delta|_sigma; GF(p)) for all k, induced subcomplex on sigma."""
   442	    S = set(sigma)
   443	    F = [f for f in faces if set(f) <= S]
   444	    by_dim = {}
   445	    for f in F:
   446	        by_dim.setdefault(len(f) - 1, []).append(f)
   447	    for k in by_dim:
   448	        by_dim[k].sort()
   449	    kmax = max(by_dim) if by_dim else -1
   450	    idx = {k: {f: t for t, f in enumerate(v)} for k, v in by_dim.items()}
   451	    rank = {}
   452	    for k in range(0, kmax + 1):
   453	        src, tgt = by_dim.get(k, []), by_dim.get(k - 1, [])
   454	        if not src or not tgt:
   455	            rank[k] = 0
   456	            continue
   457	        rows = []
   458	        for f in src:
   459	            v = [0] * len(tgt)
   460	            for r in range(len(f)):
   461	                g = f[:r] + f[r + 1:]
   462	                v[idx[k - 1][g]] = ((-1) ** r) % p
   463	            rows.append(v)
   464	        rank[k] = bf.rank_mod_p(rows, p)
   465	    out = {}
   466	    for k in range(0, kmax + 1):
   467	        out[k] = len(by_dim.get(k, [])) - rank.get(k, 0) - rank.get(k + 1, 0)
   468	    return out
