    85	def stacked_A(gens, N, dtype=complex):
    86	    """Vertically stacked annihilation matrices; ker = ker H_N, rank = dim I_N."""
    87	    blocks = [annihilation_matrix(f, N, dtype) for f in gens if poly_deg(f) <= N]
    88	    blocks = [B for B in blocks if B.shape[0] > 0]
    89	    nv = poly_nvars(gens[0])
    90	    if not blocks:
    91	        return np.zeros((0, dim_h(nv, N)), dtype=dtype)
    92	    return np.vstack(blocks)
