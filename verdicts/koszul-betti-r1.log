   154	def koszul_rank(quo, nv, i, N):
   155	    """rank over GF(p) of  d : (R/I)_N (x) Lambda^i -> (R/I)_{N+1} (x) Lambda^{i-1},
   156	    the degree-(N+i) piece of the Koszul differential of R/I on z_0..z_n."""
   157	    if i <= 0 or N < 0 or quo.hf(N) == 0:
   158	        return 0
   159	    S_src = subsets(nv, i)
   160	    S_tgt = {s: t for t, s in enumerate(subsets(nv, i - 1))}
   161	    hf1 = quo.hf(N + 1)
   162	    if hf1 == 0 or not S_tgt:
   163	        return 0
   164	    ncols = hf1 * len(S_tgt)
   165	    monos_N = bf.monomials(nv, N)
   166	    idx_N1 = bf.mono_index(nv, N + 1)
   167	    rows = []
   168	    for c in quo.nonpiv[N]:
   169	        m = monos_N[c]
   170	        for S in S_src:
   171	            v = [0] * ncols
   172	            for r, k in enumerate(S):
   173	                sign = (-1) ** r
   174	                tgtmon = tuple(m[t] + (1 if t == k else 0) for t in range(nv))
   175	                red = quo.red[N + 1][idx_N1[tgtmon]]
   176	                Sk = tuple(x for x in S if x != k)
   177	                off = S_tgt[Sk] * hf1
   178	                for coord, coeff in red.items():
   179	                    v[off + coord] = (v[off + coord] + sign * coeff) % quo.p
   180	            rows.append(v)
   181	    return bf.rank_mod_p(rows, quo.p)
