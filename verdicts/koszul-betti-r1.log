   107	    for f in gens:
   108	        m = poly_deg(f)
   109	        if m > N:
   110	            continue
   111	        for b in monomials(nv, N - m):
   112	            v = [0] * len(cols)
   113	            for a, ca in f.items():
   114	                e = tuple(a[j] + b[j] for j in range(nv))
   115	                v[cols[e]] += ca
   116	            rows.append(v)
   117	    return rows
