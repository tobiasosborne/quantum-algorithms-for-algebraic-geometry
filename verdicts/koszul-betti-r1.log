   230	def Q_block(Bs, nv, i, N):
   231	    """Matrix of Q_W : W_N (x) Lambda^i -> W_{N-1} (x) Lambda^{i+1}.
   232	    Kron order is (boson) (x) (fermion)."""
   233	    kd_s, kd_t = Bs[N].shape[1], Bs[N - 1].shape[1] if N - 1 in Bs else 0
   234	    ns, nt = math.comb(nv, i), math.comb(nv, i + 1)
   235	    if kd_s == 0 or kd_t == 0 or ns == 0 or nt == 0 or N <= 0:
   236	        return np.zeros((kd_t * nt, kd_s * ns), dtype=complex)
   237	    A = ak_matrices(nv, N)
   238	    C = cdag_matrices(nv, i)
   239	    out = np.zeros((kd_t * nt, kd_s * ns), dtype=complex)
   240	    for k in range(nv):
   241	        Ak = Bs[N - 1].conj().T @ A[k] @ Bs[N]
   242	        out += np.kron(Ak, C[k])
   243	    return out
