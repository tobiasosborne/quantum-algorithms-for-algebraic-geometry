   100	# ---------- Macaulay matrix (independent, unnormalized monomial basis) ----------
   101	def macaulay_rows(gens, N):
   102	    """Rows = coefficient vectors of z^beta * f_j, |beta| = N - deg f_j,
   103	    in the *unnormalized* monomial basis of degree N.  rank = dim I_N."""
   104	    nv = poly_nvars(gens[0])
