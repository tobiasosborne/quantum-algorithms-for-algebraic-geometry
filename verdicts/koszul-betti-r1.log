   246	def L_block(Bs, nv, i, N):
   247	    """L_W on block (i, N)."""
   248	    dim = Bs[N].shape[1] * math.comb(nv, i)
   249	    L = np.zeros((dim, dim), dtype=complex)
   250	    if dim == 0:
   251	        return L
   252	    Qout = Q_block(Bs, nv, i, N)          # (i,N) -> (i+1,N-1)
   253	    if Qout.size:
   254	        L += Qout.conj().T @ Qout
   255	    if i >= 1 and (N + 1) in Bs:
   256	        Qin = Q_block(Bs, nv, i - 1, N + 1)  # (i-1,N+1) -> (i,N)
   257	        if Qin.size:
   258	            L += Qin @ Qin.conj().T
   259	    return L
