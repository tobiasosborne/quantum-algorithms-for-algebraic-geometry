   152	def rank_numeric(rows_or_mat, tol=None):
   153	    M = np.array(rows_or_mat, dtype=complex)
   154	    if M.size == 0:
   155	        return 0
   156	    s = np.linalg.svd(M, compute_uv=False)
   157	    if tol is None:
   158	        tol = max(M.shape) * s[0] * 1e-12
   159	    return int((s > tol).sum())
