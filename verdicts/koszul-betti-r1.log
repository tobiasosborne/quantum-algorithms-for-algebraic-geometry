   184	def betti(quo, nv, i, N):
   185	    """beta_{i, i+N}(R/I) = dim K_i^{(i+N)} - rank d_i - rank d_{i+1}."""
   186	    dim = quo.hf(N) * math.comb(nv, i)
   187	    if dim == 0:
   188	        return 0
   189	    return dim - koszul_rank(quo, nv, i, N) - koszul_rank(quo, nv, i + 1, N - 1)
