   213	def cdag_matrices(nv, i):
   214	    """[c_k^dag : Lambda^i -> Lambda^{i+1}] with the fermionic sign."""
   215	    src = subsets(nv, i)
   216	    tgt = {s: t for t, s in enumerate(subsets(nv, i + 1))}
   217	    out = []
   218	    for k in range(nv):
   219	        C = np.zeros((len(tgt), len(src)))
   220	        for c, S in enumerate(src):
   221	            if k in S:
   222	                continue
   223	            sign = (-1) ** sum(1 for l in S if l < k)
   224	            T = tuple(sorted(S + (k,)))
   225	            C[tgt[T], c] = sign
   226	        out.append(C)
   227	    return out
