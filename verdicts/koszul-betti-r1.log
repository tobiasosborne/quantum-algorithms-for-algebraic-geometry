   134	                    v = int(R[ri, q]) % p
   135	                    if v:
   136	                        d[pos[q]] = (-v) % p
   137	                red[c] = d
   138	            self.nonpiv[M], self.pos[M], self.red[M] = nonpiv, pos, red
