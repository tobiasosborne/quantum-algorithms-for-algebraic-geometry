   157	def koszul_rank(quo, nv, i, N):
   158	    """rank over GF(p) of d : (R/I)_N (x) Lambda^i -> (R/I)_{N+1} (x) Lambda^{i-1}."""
   159	    if i <= 0 or N < 0 or quo.hf(N) == 0:
   160	        return 0
   161	    S_src = subsets(nv, i)
   162	    S_tgt = {s: t for t, s in enumerate(subsets(nv, i - 1))}
   163	    hf1 = quo.hf(N + 1)
   164	    if hf1 == 0 or not S_tgt:
   165	        return 0
   166	    ncols = hf1 * len(S_tgt)
   167	    monos_N, idx_N1 = bf.monomials(nv, N), bf.mono_index(nv, N + 1)
   168	    rows = []
   169	    for c in quo.nonpiv[N]:
   170	        m = monos_N[c]
   171	        for S in S_src:
   172	            v = [0] * ncols
   173	            for r, k in enumerate(S):
   174	                sign = (-1) ** r
   175	                tgt = tuple(m[t] + (1 if t == k else 0) for t in range(nv))
   176	                off = S_tgt[tuple(x for x in S if x != k)] * hf1
   177	                for coord, coeff in quo.red[N + 1][idx_N1[tgt]].items():
   178	                    v[off + coord] = (v[off + coord] + sign * coeff) % quo.p
   179	            rows.append(v)
   180	    return bf.rank_mod_p(rows, quo.p)
