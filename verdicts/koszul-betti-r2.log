   432	
   433	def cycle_complex(m):
   434	    faces = [()] + [(v,) for v in range(m)]
   435	    edges = sorted({tuple(sorted((v, (v + 1) % m))) for v in range(m)})
   436	    faces += edges
   437	    gens = [{bf.emono(m, [a, b]): 1} for a in range(m) for b in range(a + 1, m)
   438	            if (a, b) not in set(edges)]
   439	    return faces, gens, edges
   440	
   441	
   442	def reduced_homology(faces, sigma, p=P_MOD):
   443	    S = set(sigma)
   444	    F = [f for f in faces if set(f) <= S]
   445	    by_dim = {}
   446	    for f in F:
   447	        by_dim.setdefault(len(f) - 1, []).append(f)
   448	    for k in by_dim:
   449	        by_dim[k].sort()
   450	    kmax = max(by_dim) if by_dim else -1
   451	    idx = {k: {f: t for t, f in enumerate(v)} for k, v in by_dim.items()}
   452	    rank = {}
   453	    for k in range(0, kmax + 1):
   454	        src, tgt = by_dim.get(k, []), by_dim.get(k - 1, [])
   455	        if not src or not tgt:
   456	            rank[k] = 0
   457	            continue
   458	        rows = []
   459	        for f in src:
   460	            v = [0] * len(tgt)
   461	            for r in range(len(f)):
   462	                v[idx[k - 1][f[:r] + f[r + 1:]]] = ((-1) ** r) % p
   463	            rows.append(v)
   464	        rank[k] = bf.rank_mod_p(rows, p)
   465	    return {k: len(by_dim.get(k, [])) - rank.get(k, 0) - rank.get(k + 1, 0)
   466	            for k in range(0, kmax + 1)}
   467	
   468	
   469	def multidegree_split(quo, nv, i, N):
   470	    """Labels (monomial exponent, fermion subset) of the block basis, in the
   471	    monomial_kernel_basis ordering, with their total multidegree."""
   472	    monos = bf.monomials(nv, N)
   473	    lab = []
   474	    for c in quo.nonpiv[N]:
   475	        a = monos[c]
   476	        for S in subsets(nv, i):
   477	            mu = tuple(a[t] + (1 if t in S else 0) for t in range(nv))
   478	            lab.append(mu)
   479	    return lab
