   516	def counterfamily_section():
   517	    print("=" * 78)
   518	    print("(E) COUNTERFAMILY (O7): m-cycle Stanley-Reisner ideals, m = 4..12.")
   519	    print("    PROVED: the squarefree-sigma summand (sigma = all m vertices) of block")
   520	    print("    (i = m-2, N = 2) is the edge Laplacian d_1^dag d_1 of the cycle graph,")
   521	    print("    nullity 1 = b_1(C_m), smallest nonzero eigenvalue 2 - 2 cos(2 pi/m).")
   522	    print("    Delta_2 = 1 for every m.  Hence no lower bound g >= phi(Delta_N) can hold.")
   523	    print("=" * 78)
   524	    print(f"  {'m':>3} {'Delta_2':>8} {'g_sqfree':>10} {'2-2cos(2pi/m)':>14} {'':>9} "
   525	          f"{'g_total':>9} {'agree?':>7} {'g_sq/(N+i)':>11}")
   526	    for m in range(4, 13):
   527	        faces, gens, edges = cycle_complex(m)
   528	        quo = Quotient(m, gens, 4)
   529	        d2 = bf.gap_from_spectrum(bf.spectrum(gens, 2), quo.hf(2))
   530	        i, N = m - 2, 2
   531	        # squarefree sigma = all vertices: basis is the edge set, Laplacian = d1^dag d1
   532	        B = np.zeros((len(edges), m))
   533	        for e, (a, b_) in enumerate(edges):
   534	            B[e, a], B[e, b_] = 1.0, -1.0
   535	        Lsq = B @ B.T                       # d_1 d_1^dag on 1-chains
   536	        evs = np.sort(np.linalg.eigvalsh(Lsq))
   537	        nulsq = int((np.abs(evs) < TOL).sum())
   538	        gsq = float(evs[evs > TOL].min())
   539	        closed = 2 - 2 * math.cos(2 * math.pi / m)
   540	        okc = abs(gsq - closed) < 1e-9 and nulsq == 1 and abs(d2 - 1.0) < 1e-9
   541	        check(okc, f"{m}-cycle: sqfree gap {gsq} vs {closed}, nullity {nulsq}, "
   542	                   f"Delta_2 {d2}")
   543	        gtot = float("nan")
   544	        agree = "n/a"
   545	        if m <= 8:
   546	            Bs = {NN: monomial_kernel_basis(quo, m, NN) for NN in range(0, 4)}
   547	            _, gtot, _ = nullity_and_gap(L_block(Bs, m, i, N))
   548	            agree = "yes" if abs(gtot - closed) < 1e-8 else "NO"
   549	        print(f"  {m:>3} {d2:>8.4f} {gsq:>10.6f} {closed:>14.6f} "
   550	              f"{'OK' if okc else 'MISMATCH':>9} {gtot:>9.6f} {agree:>7} "
   551	              f"{gsq/(N+i):>11.6f}")
   552	    print("  Delta_2 = 1 for all m (monic monomial generators, H_2 diagonal) while the")
   553	    print("  squarefree Betti gap is Theta(m^-2): PROVED for the squarefree summand;")
   554	    print("  the total-block equality is OBSERVED for m <= 8, not proved.")
