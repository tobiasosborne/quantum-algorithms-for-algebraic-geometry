   244	    A, C = ak_matrices(nv, N), cdag_matrices(nv, i, sign)
   245	    out = np.zeros((kd_t * nt, kd_s * ns), dtype=complex)
   246	    for k in range(nv):
   247	        out += np.kron(Bs[N - 1].conj().T @ A[k] @ Bs[N], C[k])
   248	    return out
