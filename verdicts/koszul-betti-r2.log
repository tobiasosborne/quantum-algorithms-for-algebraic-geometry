   506	                hb = sum(reduced_homology(faces, s).get(N - 1, 0)
   507	                         for s in subsets(m, i + N))
   508	                nsq = sum(1 for mu in multidegree_split(quo, m, i, N)
   509	                          if max(mu) <= 1)
   510	                tag = check(nul == b == hb,
   511	                            f"{m}-cycle: (i={i},N={N}) null={nul} beta={b} Hoch={hb}")
   512	                print(f"  {i:>2} {N:>2} {i+N:>2} {dim:>7} {nsq:>7} {nul:>5} {b:>6} "
