import math
import numpy as np

# Independent arithmetic for the 5-cycle top Betti block (i,N)=(3,2).
m, i, N, beta, h = 5, 3, 2, 1, 10
M = math.comb(N + m - 1, m - 1)
b = math.comb(m, i)
ambient = beta / (M*b)
conditional = beta / (h*b)
zero_extended = ((M-h)*b + beta) / (M*b)
print(\"5-cycle M,h,b,beta:\", M,h,b,beta)
print(\"ambient harmonic-projector trace:\", ambient)
print(\"conditional trace:\", conditional)
print(\"conversion M/h:\", M/h)
print(\"zero-extended L_W zero-mode weight:\", zero_extended)

# Independent cycle incidence spectra.
for m in range(4,13):
    B=np.zeros((m,m))
    for e in range(m):
        B[e,e]=1
        B[e,(e+1)%m]=-1
    ev=np.linalg.eigvalsh(B@B.T)
    gap=ev[ev>1e-10].min()
    closed=2-2*math.cos(2*math.pi/m)
    assert abs(gap-closed)<1e-9
print(\"cycle gaps m=4..12: OK\")

# Exact CI block dimensions for the memo's n=20,c=5 row.
n,c=20,5
nv=n+1
def dh(N):
    return math.comb(N+nv-1,nv-1) if N>=0 else 0
def hf(N):
    return sum((-1)**t*math.comb(c,t)*dh(N-2*t) for t in range(c+1))
for i in (1,2,3):
    dim=hf(i)*math.comb(nv,i)
    frac=math.comb(c,i)/dim
    print(f\"CI n=20 c=5 i={i}: dim={dim}, fraction={frac:.9g}\")
