   484	    print("(D) Stanley-Reisner: the SQUAREFREE multidegree summands are simplicial")
   485	    print("    Laplacians (Hochster); the total block also carries non-squarefree")
   486	    print("    multidegrees, which the quantum-TDA theorems do NOT cover (O4).")
   487	    print("=" * 78)
   488	    for m in (4, 5, 6, 7):
   489	        faces, gens, _ = cycle_complex(m)
   490	        Nmax = 3
   491	        quo = Quotient(m, gens, Nmax + 2)
   492	        Bs = {N: monomial_kernel_basis(quo, m, N) for N in range(0, Nmax + 2)}
   493	        print(f"\n  {m}-cycle, I_Delta = {len(gens)} quadrics in P^{m-1}, "
