   101	def rref_mod_p(rows, ncols, p=P_MOD):
   102	    """Reduced row echelon form over GF(p).  Returns (R, pivots)."""
   103	    if not rows:
   104	        return np.zeros((0, ncols), dtype=np.int64), []
   105	    M = np.array([[int(x) % p for x in r] for r in rows], dtype=np.int64)
   106	    nr = M.shape[0]
   107	    r, pivots = 0, []
   108	    for c in range(ncols):
   109	        piv = None
   110	        for i in range(r, nr):
   111	            if M[i, c]:
   112	                piv = i
   113	                break
   114	        if piv is None:
   115	            continue
   116	        M[[r, piv]] = M[[piv, r]]
   117	        M[r] = (M[r] * pow(int(M[r, c]), p - 2, p)) % p
   118	        col = M[:, c].copy()
   119	        col[r] = 0
   120	        nz = np.nonzero(col)[0]
   121	        if len(nz):
   122	            M[nz] = (M[nz] - col[nz][:, None] * M[r][None, :]) % p
   123	        pivots.append(c)
   124	        r += 1
   125	        if r == nr:
   126	            break
   127	    return M[:r], pivots
