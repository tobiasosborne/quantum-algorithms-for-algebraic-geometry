    print("   I = (z_0), J = (c z_0 + s z_1), c = cos(theta), s = sin(theta).")
    print("   Closed form (this lane): Tr(P_I P_J) = sum_{a=0}^{N} c^{2a}")
    print("                                        -> 1/sin^2(theta) = 1/J.")
    print()
    nv = 3
