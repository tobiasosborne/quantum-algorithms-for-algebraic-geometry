def mons3(N):
    return [(a,b,N-a-b) for a in range(N,-1,-1) for b in range(N-a,-1,-1)]

def conic_basis(N):
    mons=mons3(N); ix={k:i for i,k in enumerate(mons)}
    B=np.zeros((len(mons),2*N+1))
    for col,d in enumerate(range(-N,N+1)):
        ad=abs(d); m=(N-ad)//2
        coeff=[1.0]
        for j in range(m):
            k2=N-ad-2*j
            coeff.append(coeff[-1]*math.sqrt(k2*(k2-1)/((j+ad+1)*(j+1))))
        coeff=np.array(coeff); coeff/=np.linalg.norm(coeff)
        for j,x in enumerate(coeff):
            if d>=0:k=(j+d,j,N-d-2*j)
            else:k=(j,j-d,N+d-2*j)
            B[ix[k],col]=x
    return mons,B

def line_basis(N,tangent):
    mons=mons3(N); ix={k:i for i,k in enumerate(mons)}
    W=np.zeros((len(mons),N+1))
    if tangent:
      for a in range(N+1): W[ix[(a,0,N-a)],a]=1
    else:
      for a in range(N+1):
        for k0 in range(a+1):
          W[ix[(k0,a-k0,N-a)],a]=math.sqrt(math.comb(a,k0)/2**a)
    return W

def tr(A,B): return float(np.linalg.norm(A.T@B)**2)
