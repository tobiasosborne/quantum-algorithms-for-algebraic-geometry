            if N <= 16:
                BI, _, _ = ground_basis([z0], N, hf)
                BJ, _, _ = ground_basis([gJ], N, hf)
                tr = tr_pp(BI, BJ)
                check(f"A theta={theta:.3f} N={N}", tr, closed)
                trs = f"{tr:14.8f}"
