import math
import numpy as np
L=-1/6+2*math.sqrt(3)*math.pi/27

def block_mean(N,d):
    m=(N-d)//2
    js=np.arange(m+1,dtype=float)
    logs=(math.lgamma(N-d+1)
          - np.array([math.lgamma(N-d-2*int(j)+1) for j in js])
          + math.lgamma(d+1)
          - np.array([math.lgamma(d+int(j)+1) for j in js])
          - np.array([math.lgamma(int(j)+1) for j in js]))
    logs-=logs.max()
    w=np.exp(logs)
    k2=N-d-2*js
    return float(np.dot(w,k2)/w.sum())

def toe(N):
    s=block_mean(N,0)
    for d in range(1,N+1): s += 2*block_mean(N,d)
    return s/(N*(2*N+1))
print('L',format(L,'.15f'))
vals=[]
for N in [22,60,100,200,400,800,1200]:
    x=toe(N)
    vals.append((N,x))
    print(N,format(x,'.15f'),'err',format(x-L,'.12g'),'Nerr',format(N*(x-L),'.12g'))
Ns=np.array([x for x,_ in vals[-5:]],float)
ys=np.array([y for _,y in vals[-5:]],float)
X=np.column_stack([np.ones_like(Ns),1/Ns,1/Ns**2,1/Ns**3])
coef=np.linalg.lstsq(X,ys,rcond=None)[0]
print('fit L,b,c,d',*[format(v,'.15g') for v in coef])
print('fit-fixed b,c,d',*[format(v,'.15g') for v in np.linalg.lstsq(X[:,1:],ys-L,rcond=None)[0]])
