          f"{'Tr/M_N':>11} {'Tr/sqrt(HFHF)':>13} {'Tr/(HF HF)':>12}"
    for theta in (math.pi / 2, 1.0, 0.4):
        c = math.cos(theta)
        s = math.sin(theta)
        gJ = {(1, 0, 0): c, (0, 1, 0): s}
        print(f"  theta = {theta:.4f} rad, 1/sin^2 = {1.0 / s**2:.6f}")
        print(hdr)
        for N in (2, 4, 6, 8, 12, 16, 24, 32, 48, 64):
            hf = N + 1
            M = bf.dim_h(nv, N)
