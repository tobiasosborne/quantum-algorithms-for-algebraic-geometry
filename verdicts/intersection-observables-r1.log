    print('N5',N,'trans',format(tr(B,line_basis(N,False)),'.10f'),'tangent',format(tr(B,line_basis(N,True)),'.10f'))

def mult_basis(f,N):
    out=mons3(N); oi={k:i for i,k in enumerate(out)}; inn=mons3(N-2)
    A=np.zeros((len(out),len(inn)))
    for j,b in enumerate(inn):
      for a,c in f.items():
        k=tuple(a[q]+b[q] for q in range(3))
        fac=math.prod(math.factorial(k[q])/math.factorial(b[q]) for q in range(3))
        A[oi[k],j]+=c*math.sqrt(fac)
    Q,_=np.linalg.qr(A,mode='reduced')
    return Q
