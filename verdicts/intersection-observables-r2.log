   843	# ================================================================= section I
   844	def section_I():
   845	    print("=" * 78)
   846	    print("I. Direct test of the Bergman lemma used in the Laplace argument:")
   847	    print("     S_V := int_V |e_p><e_p| dvol_V  ~  (pi^k / N^k) P_I   (k = dim V),")
   848	    print("   for V the conic in P^2 (k = 1).  Reported: the spectrum of S_V")
   849	    print("   rescaled by N/pi, which should concentrate at 1 on ker H_N and")
   850	    print("   at 0 on I_N.")
   851	    print()
   852	    nv = 3
   853	    conic = {(1, 1, 0): 1.0, (0, 0, 2): -1.0}
   854	
   855	    def A(u):
   856	        return (u * u + 4 * u + 1) / (u * u + u + 1) ** 2
   857	
   858	    nr, na = 900, 96
   859	    xs, ws = np.polynomial.legendre.leggauss(nr)
   860	    xs = 0.5 * (xs + 1.0)
   861	    ws = 0.5 * ws
   862	    us = xs / (1.0 - xs)
   863	    jac = 1.0 / (1.0 - xs) ** 2
   864	    # dvol = (1/2) A(u) du dphi ; u = |w|^2, point [w^2 : 1 : w]
   865	    wr = 0.5 * ws * jac * A(us)
   866	    phis = 2.0 * math.pi * np.arange(na) / na
   867	    dphi = 2.0 * math.pi / na
   868	    print(f"{'N':>4} {'HF':>5} {'min(ker)':>11} {'max(ker)':>11} "
   869	          f"{'mean(ker)':>11} {'max(I_N)':>11}")
   870	    for N in (6, 10, 14, 18):
   871	        mons = bf.monomials(nv, N)
   872	        idx = np.array(mons, dtype=np.int64)
   873	        # (p.z)^N / sqrt(N!) = sum_k sqrt(N!/k!) p^k |k>   (D-coherent-state)
   874	        coef = np.array([math.sqrt(math.factorial(N) / bf.fact_prod(m))
   875	                         for m in mons])
   876	        S = np.zeros((len(mons), len(mons)), dtype=complex)
   877	        for ph in phis:
   878	            wcpx = np.sqrt(us) * np.exp(1j * ph)
   879	            P = np.stack([wcpx ** 2, np.ones_like(wcpx) + 0j, wcpx], axis=1)
   880	            P = P / np.linalg.norm(P, axis=1, keepdims=True)
   881	            V = np.ones((len(us), len(mons)), dtype=complex)
   882	            for j in range(nv):
   883	                V = V * (P[:, j][:, None] ** idx[None, :, j])
   884	            V = V * coef[None, :]
   885	            S += (V.conj().T * (wr * dphi)) @ V
   886	        S = (S + S.conj().T) / 2
   887	        B, _, _ = ground_basis([conic], N, 2 * N + 1)
   888	        Sk = B.conj().T @ S @ B
   889	        ev = np.linalg.eigvalsh(Sk) * N / math.pi
   890	        # complement
   891	        Q = np.eye(len(mons), dtype=complex) - B @ B.conj().T
   892	        ev2 = np.linalg.eigvalsh(Q @ S @ Q) * N / math.pi
   893	        print(f"{N:>4} {2*N+1:>5} {ev.min():11.6f} {ev.max():11.6f} "
   894	              f"{ev.mean():11.6f} {abs(ev2).max():11.3e}")
   895	    print("  The eigenvalues on ker H_N concentrate at 1 with O(1/N) spread and")
   896	    print("  S_V annihilates I_N to machine precision (its range IS ker H_N,")
   897	    print("  exactly, by D-coherent-state/C-028); the lemma is the statement")
   898	    print("  that the eigenvalues are asymptotically FLAT, which is what the")
   899	    print("  min/max columns test.")
   900	    print()
