   718	def section_G():
   719	    print("=" * 78)
   720	    print("G. Toeplitz averages on the conic  V = {z_0 z_1 = z_2^2} in P^2.")
   721	    print("   D-toeplitz-operator with the degree normalisation this lane adds:")
   722	    print("   for g of bidegree (r,r) the level-N Toeplitz operator is")
   723	    print("     T_g^{(N)} = ((N-r)!/N!) P_0 :g(a^dag,a): P_0,")
   724	    print("   whose Berezin symbol is exactly g.  r=1: n_2/N.  r=2: n_2(n_2-1)/(N(N-1)).")
   725	    print("   Target: (1/vol V) int_V g dvol_V, by Gauss-Legendre quadrature on")
   726	    print("   the rational parametrisation [s:t] -> [s^2 : t^2 : s t].")
   727	    print()
   728	    # induced FS area density on the conic in u = |s/t|^2:
   729	    #   A(u) = (u^2 + 4u + 1) / (u^2 + u + 1)^2 ;  dvol = (1/2) A(u) du dphi
   730	    #   total = pi * int_0^inf A du  (= vol = deg * pi = 2 pi)
   731	    def A(u):
   732	        return (u * u + 4 * u + 1) / (u * u + u + 1) ** 2
   733	
   734	    def g1(u):      # |z_2|^2 / ||z||^2   at [u : 1 : sqrt(u)] up to phase
   735	        return u / (u * u + u + 1)
   736	
   737	    def g0(u):      # |z_0|^2 / ||z||^2
   738	        return u * u / (u * u + u + 1)
   739	
   740	    # Gauss-Legendre on x in (0,1) with u = x/(1-x)
   741	    deg = 4000
   742	    xs, ws = np.polynomial.legendre.leggauss(deg)
   743	    xs = 0.5 * (xs + 1.0)
   744	    ws = 0.5 * ws
   745	    us = xs / (1.0 - xs)
   746	    jac = 1.0 / (1.0 - xs) ** 2
   747	    w = ws * jac * A(us)
   748	    tot = float(w.sum())
   749	    avg_g1 = float((w * g1(us)).sum()) / tot
   750	    avg_g0 = float((w * g0(us)).sum()) / tot
   751	    avg_g1sq = float((w * g1(us) ** 2).sum()) / tot
   752	    print(f"  quadrature: int_0^inf A(u) du = {tot:.10f}  "
   753	          f"(exact value 2 = deg V; vol V = 2 pi)")
   754	    check("G total area", tot, 2.0, 1e-8)
   755	    print(f"  <|z_2|^2>_V = {avg_g1:.10f}      <|z_0|^2>_V = {avg_g0:.10f}")
   756	    print(f"  <|z_2|^4>_V = {avg_g1sq:.10f}    (2<|z_0|^2> + <|z_2|^2> = "
   757	          f"{2*avg_g0 + avg_g1:.10f}, must be 1)")
   758	    check("G normalisation", 2 * avg_g0 + avg_g1, 1.0, 1e-8)
   759	    print()
   760	    conic = {(1, 1, 0): 1.0, (0, 0, 2): -1.0}
   761	    nv = 3
   762	    print(f"{'N':>4} {'HF':>5} {'Tr(P0 n2)/(N HF)':>18} {'err':>12} "
   763	          f"{'Tr(P0 n2(n2-1))/(N(N-1)HF)':>28} {'err':>12}")
   764	    Ns, v1, v2 = [], [], []
   765	    for N in NGRID_P2:
   766	        hf = 2 * N + 1
   767	        B, _, _ = ground_basis([conic], N, hf)
   768	        ks = np.array(bf.monomials(nv, N), dtype=float)
   769	        n2 = ks[:, 2]
   770	        wts = np.sum(np.abs(B) ** 2, axis=1)      # diagonal of P_0
   771	        t1 = float(np.dot(wts, n2)) / (N * hf)
   772	        t2 = float(np.dot(wts, n2 * (n2 - 1.0))) / (N * (N - 1) * hf)
   773	        Ns.append(N)
   774	        v1.append(t1)
   775	        v2.append(t2)
   776	        print(f"{N:>4} {hf:>5} {t1:18.10f} {t1-avg_g1:12.3e} "
   777	              f"{t2:28.10f} {t2-avg_g1sq:12.3e}")
   778	    a1, b1 = fit_a_plus_b_over_N(Ns[-5:], v1[-5:])
   779	    a2, b2 = fit_a_plus_b_over_N(Ns[-5:], v2[-5:])
   780	    print(f"  fit  <n_2/N>   = {a1:.8f} + {b1:.6f}/N   "
   781	          f"[quadrature {avg_g1:.8f}, difference {a1-avg_g1:.2e}]")
   782	    print(f"  fit  <n2(n2-1)>= {a2:.8f} + {b2:.6f}/N   "
   783	          f"[quadrature {avg_g1sq:.8f}, difference {a2-avg_g1sq:.2e}]")
   784	    check("G Toeplitz r=1 limit", a1, avg_g1, 3e-4)
   785	    check("G Toeplitz r=2 limit", a2, avg_g1sq, 3e-3)
   786	    check("G quadrature vs exact <|z_2|^2>", avg_g1, TOEPLITZ_L1, 1e-12)
   787	    print("  The INTERCEPTS agree with the quadrature (and, for r=1, with the")
   788	    print(f"  exact value -1/6 + 2 sqrt(3) pi/27 = {TOEPLITZ_L1:.16f}).")
   789	    print("  The 1/N COEFFICIENTS above are finite-range fits over N <= 60")
   790	    print("  only (verdict O3); section K carries them to N = 1200, where the")
   791	    print("  r=1 coefficient is about 0.03144, not 0.03275.")
   792	    print("  NOTE: this is the DEGREE-NORMALISED operator, not the registered")
   793	    print("  D-toeplitz-operator.  With the registered operator the ratio is")
   794	    print("  N times these numbers and diverges, which is why C-086/C-168 are")
   795	    print("  proposed REFUTED as written (verdict O3).")
   796	    print()
