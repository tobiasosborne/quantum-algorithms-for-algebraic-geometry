+def h_complete(xs, N):
+    """Complete homogeneous symmetric polynomial h_N(x_1..x_r), by DP."""
+    dp = np.zeros(N + 1)
+    dp[0] = 1.0
+    for x in xs:
+        for k in range(1, N + 1):
+            dp[k] += x * dp[k - 1]
+    return float(dp[N])
