+def ortho_complement(Q):
+    m = Q.shape[0]
+    P = np.eye(m, dtype=complex) - Q @ Q.conj().T
+    u, sv, _ = np.linalg.svd(P)
+    return u[:, : int((sv > 1e-10).sum())]
+
+
+def linear_gens(Uperp):
