   929	def pred_toeplitz_ordering(shift=0):
   930	    """M2: the ORDERING mutation.  shift = 0 is the normal-ordered
   931	    D-normalised-toeplitz-operator; shift = 1 is the anti-normal alternative
   932	    (n_2 -> n_2 + 1), which changes the level-N value by exactly 1/N and the
   933	    asymptotic 1/N coefficient by exactly +1.  The r0 script fitted a free
   934	    intercept AND a free 1/N coefficient, so it absorbed this mutation; here
   935	    the intercept is PINNED to the exact Fubini-Study average and the
   936	    coefficient must land inside a fixed window."""
   937	    bs = []
   938	    for N in (400, 800, 1200):
   939	        t1, _, hf = conic_kernel_moments(N)
   940	        v = (t1 + shift * hf) / (N * hf)
   941	        bs.append(N * (v - TOEPLITZ_L1))
   942	    lo, hi = TOEPLITZ_B1_WINDOW
   943	    ok = all(lo <= b <= hi for b in bs)
   944	    return ok, f"b_N at N=400,800,1200: {[round(b, 6) for b in bs]}, window {(lo, hi)}"
