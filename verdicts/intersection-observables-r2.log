# Independent recurrence in Fock amplitudes, using log-sum-exp but derived
# directly from A_{j+1}/A_j = sqrt[k2(k2-1)/((j+d+1)(j+1))].
import math
L=-1/6+2*math.sqrt(3)*math.pi/27

def moment(N):
    total=0.0; blocks=0
    for d in range(-N,N+1):
        lo=max(0,-d); hi=(N-d)//2
        if lo>hi: continue
        logs=[0.0]
        for j in range(lo,hi):
            k2=N-2*j-d
            logs.append(logs[-1]+0.5*(math.log(k2)+math.log(k2-1)-math.log(j+d+1)-math.log(j+1)))
        mx=max(logs)
        ws=[math.exp(2*(x-mx)) for x in logs]
        den=sum(ws)
        total += sum(w*(N-2*j-d) for w,j in zip(ws,range(lo,hi+1)))/den
        blocks+=1
    return total/(N*blocks),blocks
for N in (22,60,200,400,800,1200,1600,2400):
    v,h=moment(N)
    print(N,h,format(v,'.15f'),format(N*(v-L),'.12f'))
# Extrapolate b_N = b + c/N from last values
vs=[]
for N in (800,1200,1600,2400):
 v,_=moment(N); vs.append((N,N*(v-L)))
import numpy as np
X=np.array([[1,1/N] for N,b in vs]); y=np.array([b for N,b in vs])
coef=np.linalg.lstsq(X,y,rcond=None)[0]
print('b extrap',coef)
